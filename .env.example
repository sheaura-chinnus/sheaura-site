# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Server
PORT=4000
NODE_ENV=development

# Session (Required - min 32 random characters)
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Admin Dashboard Password (Required to unlock /admin portal in production)
ADMIN_PASSWORD=your-secure-admin-password

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Cross-Site Cookie Support (Set to 'true' when hosting frontend on Cloudflare Pages and backend on Render)
CROSS_SITE_COOKIES=false

# Additional CORS Allowed Origins (comma-separated, e.g. https://sheaura.pages.dev,https://customdomain.com)
ADDITIONAL_ALLOWED_ORIGINS=

# Private Preview Access Token (Optional: requires '?access=token' query parameter or cookie)
PRIVATE_ACCESS_TOKEN=sheaura-vip-2026

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staging Mode Basic Auth (Optional HTTP Basic Auth gate)
STAGING_MODE=false
STAGING_USERNAME=admin
STAGING_PASSWORD=password

# S3/Cloud Storage (Optional - Database media storage fallback is active by default)
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=sheaura-images
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
