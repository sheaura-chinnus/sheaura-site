# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sheaura

# Server
PORT=4000
NODE_ENV=development

# Session (Required - min 32 random characters)
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Admin Dashboard Password (Required to unlock /admin portal in production)
ADMIN_PASSWORD=your-secure-admin-password

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Staging Mode Basic Auth (Optional for staging isolation)
STAGING_MODE=false
STAGING_USERNAME=admin
STAGING_PASSWORD=password

# S3/Cloud Storage (Optional - Database storage fallback is active by default)
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=sheaura-images
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com